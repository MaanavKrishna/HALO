#!/bin/sh
# Block commits that stage secrets: .env files or API keys (sk-ant- prefix).
staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0

if echo "$staged" | grep -qE '(^|/)\.env$'; then
  echo "pre-commit: refusing to commit .env" >&2
  exit 1
fi

if git diff --cached -U0 --diff-filter=ACM | grep -E '^\+' | grep -qE 'sk-ant-[A-Za-z0-9_-]{20,}'; then
  echo "pre-commit: staged content looks like an API key (sk-ant-...)" >&2
  exit 1
fi
exit 0
